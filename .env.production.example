# Actual private values: .local/deployment/production.env (ignored; owner-only).
DATABASE_URL=postgresql://ecogrowth_app:REPLACE@NEON-POOLER/ecogrowth?sslmode=verify-full
# Migration owner is local/CI only; do not upload to Vercel runtime.
MIGRATION_DATABASE_URL=postgresql://ecogrowth_owner:REPLACE@NEON-DIRECT/ecogrowth?sslmode=verify-full
BETTER_AUTH_SECRET=GENERATE_UNIQUE_RANDOM_SECRET
BETTER_AUTH_URL=https://egrth.vercel.app
ALLOWED_ORIGINS=https://egrth.vercel.app
DEMO_MODE=false
VITE_DEMO_MODE=false
CRON_SECRET=GENERATE_SEPARATE_RANDOM_SECRET
EXPO_PUBLIC_API_URL=https://egrth.vercel.app
# Same-origin web API: leave VITE_API_URL unset.
# S3/mail/push/event/scheduler identities are not configured by these values.
